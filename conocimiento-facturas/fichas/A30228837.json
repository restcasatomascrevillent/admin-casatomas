    "retencion_irpf": false,
    "envases": null,
    "cargos_y_descuentos_pie": [],
    "trampas": [
      "Cada artículo ocupa 2 o más filas: 1ª fila 'código descripción | cantidad | U | precio | importe'; 2ª fila = formato del bulto + 'Partida: nnnn IVA:10.00%'; 3ª fila opcional 'n,00 x Lote: … F.C.:fecha'. El IVA de cada línea está en la 2ª fila.",
      "'Partida:' es el número de partida (lote interno), no un precio ni una cantidad. 'F.C.:01/01/1900' es una fecha vacía.",
      "Hay líneas negativas (abonos/devoluciones, p. ej. -1.00 U 7.66 = -7.66) que restan del total.",
      "Hay líneas a 0,00 (artículos regalados: atún Claramar 1 kg, mantequilla porciones).",
      "Los precios se redondean a 2 decimales pero se multiplican con más: 6 × 12,50 = 74,97 en los brownies (precio real 12,495); 3 × 21,18 = 63,53.",
      "Una misma factura mezcla tres tipos de IVA (4 %, 10 %, 21 %); el 21 % solo aparece en el papel de horno.",
      "Si hay 2 páginas, los totales solo están en la última.",
      "El texto legal y el registro mercantil del pie no son datos."
    ]
  },

  "reglas_cuadre": [
    "importe_linea = cantidad × precio (o kg × precio/kg en líneas K), con redondeo; la línea negativa resta",
    "Importe Bruto = suma de todas las líneas = suma de las bases de IVA",
    "El pie lista una fila por tipo: 'Base IVA | % IVA | Cuota IVA' (p. ej. 122,20 | 4,00 | 4,89 y 274,73 | 10,00 | 27,47 y 0,00 | 25,98 | 21,00 | 5,46)",
    "Total factura = bruto + suma de cuotas de IVA. Ejemplo R148: 422,91 + 4,89 + 27,47 + 5,46 = 460,73",
    "Ejemplo con abono R315: 606,88 + 4,47 + 49,51 = 660,86"
  ],

