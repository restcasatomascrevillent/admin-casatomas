  "lectura": {
    "columnas": ["CÓD. ARTÍCULO", "DESCRIPCIÓN", "C.J.", "UNID", "%DTO", "PRECIO", "TOTAL"],
    "cantidad_es": "botellas en UNID (C.J. = cajas completas; UNID ya incluye todas las botellas, cajas x 6 más sueltas)",
    "columna_peso": null,
    "precio_es_por": "botella",
    "descuento_por_linea": { "existe": true, "columna": "%DTO (a veces 9,00 % en la línea; normalmente 0,00 % y el descuento va en el pie)", "valores_habituales": [9] },
    "iva_por_linea": false,
    "tipos_iva": [21],
    "recargo_equivalencia": false,
    "retencion_irpf": false,
    "envases": null,
    "cargos_y_descuentos_pie": [
      "Descuento comercial del 9 % sobre la suma de líneas, impreso como IMPORTE en la casilla '% DTO.' del pie (p. ej. 60,83 sobre 675,88; 7,43 sobre 82,60)",
      "El pie imprime una tabla fija de tipos de IVA (5, 10, 21, 4, 7,5) con sus recargos de equivalencia (0,62; 1,4; 5,2; 0,5; 1) que NO se aplican"
    ],
    "trampas": [
      "'007183' es el código de cliente, no el número de factura (que empieza por 29).",
      "Líneas con C.J. 0,00 y UNID 4,00: son botellas sueltas; no multiplicar por 6.",
      "Líneas repetidas con precio 0,000 y total 0,000 son botellas regaladas/bonificadas (el mismo código aparece dos veces): conservarlas con importe 0.",
      "La caja es de 6 botellas en todas las muestras (2 cajas = 12 UNID).",
      "En el pie, la tabla 5/0,62 · 10/1,4 · 21/5,2 · 4/0,5 · 7,5/1 son porcentajes de recargo, no importes: el IVA real es solo el de 21 %.",
      "El descuento del pie sale como un número suelto en la columna '% DTO.' (importe en euros, no porcentaje).",
      "Los precios llevan 3 decimales y los miles con punto (1.804,500).",
      "Abonos: cantidades y totales negativos (-5 cajas, -33 UNID, -365,900), con IVA y total negativos.",
      "Un PDF de 3 páginas puede ser 3 facturas distintas (cada una con su número 29000…)."
    ]
  },

  "reglas_cuadre": [
    "total_linea = UNID x precio x (1 - dto_linea/100); las líneas a precio 0 suman 0",
    "descuento_pie = 9 % x suma de líneas (cuando el %DTO de las líneas es 0)",
    "base = suma de líneas - descuento_pie (675,88 - 60,83 = 615,05; 82,60 - 7,43 = 75,17)",
    "iva = base x 21 % (615,05 x 21 % = 129,16; 75,17 x 21 % = 15,79)",
    "total = base + iva (615,05 + 129,16 = 744,21; 75,17 + 15,79 = 90,96)",
    "si el 9 % ya viene en el %DTO de la línea (Sambuca: 2 x 14,48 x 0,91 = 26,35) no hay descuento adicional en el pie (26,35 + 5,53 = 31,88)"
  ],

